/* no CONFIG_PICOCOREMX8MX_NANO_GPU define exists for this module, and
 * i.MX8MN has no VPU block at all (unlike the mx8mm sibling) - the GPU
 * accelerator was always enabled unconditionally before the hardening
 * rework, keep that behaviour here. */
&gpu { status = "okay"; };

&lcdif { status = "okay"; };

#ifdef CONFIG_PICOCOREMX8MX_NANO_MIPI_DSI
&mipi_dsi { status = "okay"; };
#endif /* CONFIG_PICOCOREMX8MX_NANO_MIPI_DSI */

#ifdef SUPPORT_M4
&mu { status = "okay"; };
#endif /* SUPPORT_M4 */
