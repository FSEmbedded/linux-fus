#ifdef CONFIG_PICOCOREMX8MX_NANO_PWM_A
&fs_pwm_a { status = "okay"; };
#endif /* CONFIG_PICOCOREMX8MX_NANO_PWM_A */

#ifdef CONFIG_PICOCOREMX8MX_NANO_BL_CTRL
&fs_bl_pwm { status = "okay"; };
&reg_ldb_bl { status = "okay"; };
&backlight_ldb { status = "okay"; };
#endif /* CONFIG_PICOCOREMX8MX_NANO_BL_CTRL */

#ifdef CONFIG_PICOCOREMX8MX_NANO_SPI_A
&fs_spi_a {
	pinctrl-0 = <&pinctrl_fs_spi_a>, <&pinctrl_fs_spi_a_cs>;
	num-cs = <1>;
	cs-gpios = <&gpio5 9 GPIO_ACTIVE_LOW>;
	status = "okay";

	spidev@0 {
		compatible = "linux,spidev";
		spi-max-frequency = <20000000>;
		reg = <0>;
		status = "okay";
	};
};
#endif /* CONFIG_PICOCOREMX8MX_NANO_SPI_A */

#ifdef CONFIG_PICOCOREMX8MX_NANO_SPI_B
&fs_spi_b {
	pinctrl-0 = <&pinctrl_fs_spi_b>, <&pinctrl_fs_spi_b_cs>;
	num-cs = <1>;
	cs-gpios = <&gpio5 25 GPIO_ACTIVE_LOW>;
	status = "okay";

	spidev@0 {
		compatible = "linux,spidev";
		spi-max-frequency = <20000000>;
		reg = <0>;
		status = "okay";
	};
};
#endif /* CONFIG_PICOCOREMX8MX_NANO_SPI_B */

#ifdef CONFIG_PICOCOREMX8MX_NANO_SPI_C
&fs_spi_c {
	pinctrl-0 = <&pinctrl_fs_spi_c>, <&pinctrl_fs_spi_c_cs>;
	num-cs = <1>;
	cs-gpios = <&gpio5 13 GPIO_ACTIVE_LOW>;
	status = "okay";
#ifdef CONFIG_PICOCOREMX8MX_NANO_CAN_A
	mcp25xxfd@0 { status = "okay"; };
#else
	spidev@0 {
		compatible = "linux,spidev";
		spi-max-frequency = <20000000>;
		reg = <0>;
		status = "okay";
	};
#endif
};
#endif /* CONFIG_PICOCOREMX8MX_NANO_SPI_C */

#ifdef CONFIG_PICOCOREMX8MX_NANO_UART_A
&fs_uart_a { /* console */
#ifdef CONFIG_PICOCOREMX8MX_NANO_UART_A_RTSCTS
	pinctrl-0 = <&pinctrl_fs_uart_a>, <&pinctrl_fs_uart_a_rtscts>;
	fsl,uart-has-rtscts;
#endif
	status = "okay";
};
#endif /* CONFIG_PICOCOREMX8MX_NANO_UART_A */

#ifdef CONFIG_PICOCOREMX8MX_NANO_UART_B
&fs_uart_b {
#ifdef CONFIG_PICOCOREMX8MX_NANO_UART_B_RTSCTS
	pinctrl-0 = <&pinctrl_fs_uart_b>, <&pinctrl_fs_uart_b_rtscts>;
	fsl,uart-has-rtscts;
#endif
	status = "okay";
};
#endif /* CONFIG_PICOCOREMX8MX_NANO_UART_B */

#ifdef CONFIG_PICOCOREMX8MX_NANO_UART_C
&fs_uart_c { status = "okay"; };
#endif /* CONFIG_PICOCOREMX8MX_NANO_UART_C */

#ifdef CONFIG_PICOCOREMX8MX_NANO_UART_D
&fs_uart_d { status = "okay"; };
#endif /* CONFIG_PICOCOREMX8MX_NANO_UART_D */

#ifdef CONFIG_PICOCOREMX8MX_NANO_USB_OTG1
#ifdef CONFIG_PICOCOREMX8MX_NANO_USB_OTG1_USBC
/* USB-C - ALERT/interrupt not routed on this board, always polling */
&fs_i2c_d {
	ptn5110: tcpc@52 {
		compatible = "nxp,ptn5110";
		reg = <0x52>;
		status = "okay";

		port {
			typec1_dr_sw: endpoint {
				remote-endpoint = <&usb1_drd_sw>;
			};
		};

		typec1_con: connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "dual";
			data-role = "dual";
			try-power-role = "sink";
			source-pdos = <PDO_FIXED(5000, 3000,
			PDO_FIXED_USB_COMM)>;
			sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)
				     PDO_VAR(5000, 20000, 3000)>;
			op-sink-microwatt = <15000000>;
			self-powered;
		};
	};
};
#endif /* CONFIG_PICOCOREMX8MX_NANO_USB_OTG1_USBC */

&fs_usb_otg {
	dr_mode = "otg";
	status = "okay";
#ifdef CONFIG_PICOCOREMX8MX_NANO_USB_OTG1_USBC
	hnp-disable;
	srp-disable;
	adp-disable;
	usb-role-switch;

	port {
		usb1_drd_sw: endpoint {
			remote-endpoint = <&typec1_dr_sw>;
		};
	};
#endif /* CONFIG_PICOCOREMX8MX_NANO_USB_OTG1_USBC */
};
#endif /* CONFIG_PICOCOREMX8MX_NANO_USB_OTG1 */

#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_A
&fs_sdio_a {
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_fs_sdio_a &pinctrl_fs_sdio_a_gpio
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_A_CD
		     &pinctrl_fs_sdio_a_cd
#endif
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_A_WP
		     &pinctrl_fs_sdio_a_wp
#endif
		    >;
	pinctrl-1 = <&pinctrl_fs_sdio_a_100mhz &pinctrl_fs_sdio_a_gpio
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_A_CD
		     &pinctrl_fs_sdio_a_cd
#endif
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_A_WP
		     &pinctrl_fs_sdio_a_wp
#endif
		    >;
	pinctrl-2 = <&pinctrl_fs_sdio_a_200mhz &pinctrl_fs_sdio_a_gpio
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_A_CD
		     &pinctrl_fs_sdio_a_cd
#endif
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_A_WP
		     &pinctrl_fs_sdio_a_wp
#endif
		    >;
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_A_8_BIT
	pinctrl-0 = <&pinctrl_fs_sdio_a_8bit &pinctrl_fs_sdio_a_gpio
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_A_CD
		     &pinctrl_fs_sdio_a_cd
#endif
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_A_WP
		     &pinctrl_fs_sdio_a_wp
#endif
		    >;
	pinctrl-1 = <&pinctrl_fs_sdio_a_100mhz_8bit &pinctrl_fs_sdio_a_gpio
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_A_CD
		     &pinctrl_fs_sdio_a_cd
#endif
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_A_WP
		     &pinctrl_fs_sdio_a_wp
#endif
		    >;
	pinctrl-2 = <&pinctrl_fs_sdio_a_200mhz_8bit &pinctrl_fs_sdio_a_gpio
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_A_CD
		     &pinctrl_fs_sdio_a_cd
#endif
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_A_WP
		     &pinctrl_fs_sdio_a_wp
#endif
		    >;
	bus-width = <8>;
#endif /* CONFIG_PICOCOREMX8MX_NANO_SD_A_8_BIT */
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_A_CD
	cd-gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
#else
	non-removable;
#endif
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_A_WP
	wp-gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>;
#endif
	status = "okay";
};
#endif /* CONFIG_PICOCOREMX8MX_NANO_SD_A */

#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_B
&fs_sdio_b {
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_fs_sdio_b &pinctrl_fs_sdio_b_gpio
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_B_CD
		     &pinctrl_fs_sdio_b_cd
#endif
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_B_WP
		     &pinctrl_fs_sdio_b_wp
#endif
		    >;
	pinctrl-1 = <&pinctrl_fs_sdio_b_100mhz &pinctrl_fs_sdio_b_gpio
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_B_CD
		     &pinctrl_fs_sdio_b_cd
#endif
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_B_WP
		     &pinctrl_fs_sdio_b_wp
#endif
		    >;
	pinctrl-2 = <&pinctrl_fs_sdio_b_200mhz &pinctrl_fs_sdio_b_gpio
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_B_CD
		     &pinctrl_fs_sdio_b_cd
#endif
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_B_WP
		     &pinctrl_fs_sdio_b_wp
#endif
		    >;
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_B_CD
	cd-gpios = <&gpio2 12 GPIO_ACTIVE_LOW>;
#else
	non-removable;
#endif
#ifdef CONFIG_PICOCOREMX8MX_NANO_SD_B_WP
