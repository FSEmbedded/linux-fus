#ifdef CONFIG_PICOCOREMX8MX_NANO_I2C_C
&fs_i2c_c { status = "okay"; };
#endif /* CONFIG_PICOCOREMX8MX_NANO_I2C_C */

&eeprom { status = "okay"; };

&snvs_pwrkey { status = "okay"; };

#ifdef CONFIG_PICOCOREMX8MX_NANO_SGTL5000_AUDIO
&fs_i2s_a { status = "okay"; };
&easrc { status = "okay"; };
&reg_sgtl5000_vdda { status = "okay"; };
&reg_sgtl5000_vddio { status = "okay"; };
&reg_sgtl5000_vddd { status = "okay"; };
&sound_sgtl5000 { status = "okay"; };
