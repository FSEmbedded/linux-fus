#ifdef CONFIG_PICOCOREMX8MX_NANO_I2C_A
&fs_i2c_a { status = "okay"; };
#endif /* CONFIG_PICOCOREMX8MX_NANO_I2C_A */

#ifdef CONFIG_PICOCOREMX8MX_NANO_I2C_B
