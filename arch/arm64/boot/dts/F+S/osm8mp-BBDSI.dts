#ifdef CONFIG_OSM8MP_USB_A
&usb3_phy0 { status = "okay"; };

&usb3_0 { status = "okay"; };

&osm_usb_a {
	dr_mode = "otg";
#ifdef CONFIG_OSM8MP_USB_A_USBC
	hnp-disable;
	srp-disable;
	adp-disable;
	usb-role-switch;
	status = "okay";
	port {
		usb1_drd_sw: endpoint {
			remote-endpoint = <&typec1_dr_sw>;
		};
	};
#endif
};

#ifdef CONFIG_OSM8MP_USB_A_USBC
&osm_i2c_b {
	/* USB-C */
	ptn5110: tcpc@52 {
		compatible = "nxp,ptn5110";
#ifdef CONFIG_OSM8MP_USB_A_USBC_ALERT
#if CONFIG_ADP_OSM_BOARD_REVISION < 130
		interrupt-parent = <&gpio1>;
		interrupts = <10 IRQ_TYPE_LEVEL_LOW>;
#endif
#endif
		reg = <0x52>;
		status = "okay";

		port {
			typec1_dr_sw: endpoint {
				remote-endpoint = <&usb1_drd_sw>;
			};
		};

		typec1_con: connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "dual";
			data-role = "dual";
			try-power-role = "sink";
			source-pdos = <PDO_FIXED(5000, 3000,
			PDO_FIXED_USB_COMM)>;
			sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)
				     PDO_VAR(5000, 20000, 3000)>;
			op-sink-microwatt = <15000000>;
			self-powered;
		};
	};
};
#endif  /* CONFIG_OSM8MP_USB_A_USBC */
#endif  /* CONFIG_OSM8MP_USB_A */

