	pinctrl-1 = <&pinctrl_osm_sdio_b_100mhz>, <&pinctrl_osm_sdio_b_cd>, <&pinctrl_osm_sdio_b_wp>, <&pinctrl_osm_sdio_b_rst>;
	pinctrl-2 = <&pinctrl_osm_sdio_b_200mhz>, <&pinctrl_osm_sdio_b_cd>, <&pinctrl_osm_sdio_b_wp>, <&pinctrl_osm_sdio_b_rst>;
