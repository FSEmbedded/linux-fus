&osm_i2s_a { status = "okay"; };

#ifdef CONFIG_OSM8MP_SGTL5000_AUDIO
/{
	regulators {
		/* SGTL5000 analog voltage */
		reg_sgtl5000_vdda: sgtl5000_vdda {
			compatible = "regulator-fixed";
			regulator-name = "VDDA-supply";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			regulator-always-on;
		};

		/* SGTL5000 I/O voltage */
		reg_sgtl5000_vddio: sgtl5000_vddio {
			compatible = "regulator-fixed";
			regulator-name = "VDDIO-supply";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			regulator-always-on;
		};

		/* SGTL5000 internal digital voltage */
		reg_sgtl5000_vddd: sgtl5000_vddd {
			compatible = "regulator-fixed";
			regulator-name = "VDDD-supply";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-always-on;
		};
	};

	reg_sgtl_clk: regulator-sgtl-clk {
			compatible = "regulator-fixed-clock";
			regulator-always-on;
			regulator-name = "SGTL_CLK";
			clocks = <&clk IMX8MP_CLK_CLKOUT1>;
			assigned-clocks = <&clk IMX8MP_CLK_CLKOUT1>;
			assigned-clock-rates = <24576000>;
	};

	sound_sgtl5000: sound-sgtl5000 {
		compatible = "fsl,imx-audio-sgtl5000";
		model = "imx-sgtl5000";
		audio-cpu = <&osm_i2s_a>;
		audio-codec = <&sgtl5000>;
		audio-asrc = <&easrc>;
		audio-routing =
			"LINE_IN", "Line In Jack",
			"Mic Jack", "Mic Bias",
			"MIC_IN", "Mic Jack",
			"Line Out Jack", "LINE_OUT",
			"Headphone Jack", "HP_OUT";
	};
};

&osm_i2c_b {
	status = "okay";
	sgtl5000: sgtl5000@a {
		compatible = "fsl,sgtl5000";
		reg = <0xa>;
		mono2both;
		clocks = <&clk IMX8MP_CLK_CLKOUT1>;
		VDDA-supply = <&reg_sgtl5000_vdda>;
		VDDIO-supply = <&reg_sgtl5000_vddio>;
		VDDD-supply = <&reg_sgtl5000_vddd>;
	};
};

&easrc {
	fsl,asrc-rate  = <48000>;
	status = "okay";
};
#endif /* CONFIG_OSM8MP_SGTL5000_AUDIO */
#endif /* CONFIG_OSM8MP_I2S_A */

