/* Check for invalid CONFIG combinations */

/*
 * Exclude devices from Linux that are used by the Cortex-M4 FreeRTOS examples
 *
 * - UART_D: Debug Console for Cortex-M4
 * - I2C_A:  I2C Bus used in I2C examples
 * - I2C_D:  I2C Bus used by the Audio Codec in SAI examples
 * - SPI_B:  SPI_B is used for ECSPI examples
 * - SDMA1:  Gets removed at another Point, it is used by SPI_B and UART driver
 *           examples
 * - SPI_A:  SPI_A using SDMA1 but SDMA1 is excluded so also exclude SPI_A
 *
 * In addition the following pins are already predefined in FreeRTOS to be used
 * as arbitrary GPIOs. Please remove the comment of the appropriate line of
 * each device from which you use any signal in your own application.
 *
 * - AUDIO_3: GPT capture driver example uses one of its Pins
 */
#ifdef SUPPORT_M4
#undef CONFIG_OSM8MP_UART_C
//#undef CONFIG_OSM8MP_I2C_A
//#undef CONFIG_OSM8MP_SPI_A
//#undef CONFIG_OSM8MP_SPI_B
/* Only undef if using audio/sai examples */
//#undef CONFIG_OSM8MP_I2C_B
//#undef CONFIG_OSM8MP_I2S_A
#endif

/* Disable PWM_0 if BL_CTRL is enabled */
#ifdef CONFIG_OSM8MP_BL_CTRL
#undef CONFIG_OSM8MP_PWM_0
#endif

/* Disable PWM_2 if SPI_A_CS1 is enabled */
#ifdef CONFIG_OSM8MP_SPI_A_CS1
#undef CONFIG_OSM8MP_PWM_2
#endif

/* Disable PWM_2 if SPI_B_CS1 is enabled */
#ifdef CONFIG_OSM8MP_SPI_B_CS1
#undef CONFIG_OSM8MP_PWM_3
#endif

/* Set different settings for corresponding baseboard revision */
#if CONFIG_PICOCOREBBDSI_BOARD_REVISION < 130
#undef CONFIG_OSM8MP_USB_A_USBC
#endif

#if !defined(CONFIG_OSM8MP_USB_A_USBC) \
    || (CONFIG_PICOCOREBBDSI_BOARD_REVISION < 140)
#undef CONFIG_OSM8MP_USB_A_USBC_ALERT
#endif


#include "osm8mp.dts"
#include <fsversion.h>
/ {
	model = "F&S OSM8MP-BBDSI";

	chosen {
		bootargs = "console=ttymxc0,115200 earlycon=ec_imx6q,0x30890000,115200";
		stdout-path = &osm_uart_con;
	};

	reg_mipi_rst: regulator_mipi_rst {
		compatible = "regulator-fixed";
		regulator-name = "MIPI_RST";
		gpio = <&pca6416 5 GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
		enable-active-high;
		startup-delay-us = <1000>;
		off-on-delay-us = <12000>;
	};

	reg_touch_rst: regulator_touch_rst {
		compatible = "regulator-fixed";
		regulator-name = "TOUCH_RST";
		gpio = <&pca6416 6 GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
		enable-active-high;
		startup-delay-us = <1000>;
		off-on-delay-us = <12000>;
	};

};

&reserved_mem {
	#address-cells = <2>;
	#size-cells = <2>;
	ranges;

	linux,cma {
		compatible = "shared-dma-pool";
		reusable;
		size = <0 0x14000000>;
		alloc-ranges = <0 0x40000000 0 0x40000000>;
		linux,cma-default;
	};
};

&bdinfo{
	dts_version = FS_LINUX_VERSION;
	board_name = "osm8mp";
};

#if defined(CONFIG_OSM8MP_BL_CTRL) || defined(CONFIG_OSM8MP_PWM_0)
&osm_pwm_0 { status = "okay"; };
#endif /* CONFIG_OSM8MP_BL_CTRL || CONFIG_OSM8MP_PWM_0 */

#ifdef CONFIG_OSM8MP_PWM_1
&osm_pwm_1 { status = "okay"; };
#endif /* CONFIG_OSM8MP_PWM_1 */

#ifdef CONFIG_OSM8MP_PWM_2
&osm_pwm_2 { status = "okay"; };
#endif /* CONFIG_OSM8MP_PWM_2 */

#ifdef CONFIG_OSM8MP_PWM_3
&osm_pwm_3 { status = "okay"; };
#endif /* CONFIG_OSM8MP_PWM_3 */

#ifdef CONFIG_OSM8MP_ETH_A
&osm_eth_a {
	phy-mode = "rgmii-id";
	phy-handle = <&ethphy4>;
	status = "okay";

	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy4: ethernet-phy@4 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <4>;
			rtl821x,clkout-disable;
			rtl821x,aldps-enable;
			rtl821x,ssc-rxc-enable;
			rtl821x,ssc-sysclk-enable;
			rtl821x,ssc-clkout-enable;
			rtl821x,led-link = <2>; // LED1 for link indication
			rtl821x,led-act = <2>; // LED1 for activity
			reset-gpios = <&pca6416 0 GPIO_ACTIVE_LOW>;
			reset-assert-us = <10000>;
			reset-deassert-us = <100000>;
			interrupt-parent = <&pca6416>;
			interrupts = <2 IRQ_TYPE_EDGE_FALLING>;
			eee-broken-1000t;
		};
	};
};
#endif /* CONFIG_OSM8MP_ETH_A */

#ifdef CONFIG_OSM8MP_ETH_B
&osm_eth_b {
	phy-mode = "rgmii-id";
	phy-handle = <&ethphy2>;
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy2: ethernet-phy@2 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <2>;
			rtl821x,clkout-disable;
			rtl821x,aldps-enable;
			rtl821x,ssc-rxc-enable;
			rtl821x,ssc-sysclk-enable;
			rtl821x,ssc-clkout-enable;
			rtl821x,led-link = <2>; // LED1 for link indication
			rtl821x,led-act = <2>; // LED1 for activity
			reset-gpios = <&pca6416 1 GPIO_ACTIVE_LOW>;
			reset-assert-us = <10000>;
			reset-deassert-us = <100000>;
			interrupt-parent = <&pca6416>;
			interrupts = <3 IRQ_TYPE_EDGE_FALLING>;
			eee-broken-1000t;
		};
	};
};
#endif /* CONFIG_OSM8MP_ETH_B */

#ifdef CONFIG_OSM8MP_I2C_A
&osm_i2c_a { status = "okay"; };
#ifdef CONFIG_OSM8MP_EEPROM
&eeprom { status = "okay"; };
#endif /* CONFIG_OSM8MP_EEPROM */
#endif /* CONFIG_OSM8MP_I2C_A */

#ifdef CONFIG_OSM8MP_I2C_B
&osm_i2c_b { status = "okay"; };
#if CONFIG_ADP_OSM_BOARD_REVISION >= 130
&osm_i2c_b {
	/* GPIO expander */
	pca6416: gpio@20 {
		compatible = "nxp,pcal6416";
		reg = <0x20>;
		vcc-supply = <&reg_vref_1v8>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio1>;
		interrupts = <6 IRQ_TYPE_LEVEL_LOW>;
		/* Enable Open-Drain for Port 0 and 1 */
		pcal6416,open-drain;
		gpio-line-names =
		/*  0 */ "", "", "", "",
		/*  4 */ "AUDIO_B_I2S_RXFS", "GPIO_J1_7", "GPIO_J1_2", "BL_ON",
		/*  8 */ "VLCD_ON", "GPIO_J1_44", "GPIO_J1_46", "",
		/* 12 */ "", "", "", "";
		status = "okay";
	};
};
#endif /* CONFIG_ADP_OSM_BOARD_REVISION >= 130 */
#endif /* CONFIG_OSM8MP_I2C_B */

#ifdef CONFIG_OSM8MP_I2C_CAM_PCI
&osm_i2c_cam_pci { status = "okay"; };
#endif /* CONFIG_OSM8MP_I2C_CAM_PCI */

#ifdef CONFIG_OSM8MP_SPI_A
/ {
	/* osm_spi_a overwritten by SPI bitbanging driver */
	/delete-node/ &osm_spi_a;
	/* SPI bitbanging driver */
	osm_spi_a: spi {
		compatible = "spi-gpio";
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		sck-gpios = <&gpio3 0 0>;
		miso-gpios = <&gpio3 7 0>;
		mosi-gpios = <&gpio3 6 0>;
		cs-gpios = <&gpio3 1 0>;
		num-chipselects = <1>;

		spidev@0 {
			compatible = "linux,spidev";
			spi-max-frequency = <20000000>;
			reg = <0>;
			status = "okay";
		};
	};
};
#endif /* CONFIG_OSM8MP_SPI_A */

#ifdef CONFIG_OSM8MP_SPI_B
&osm_spi_b {
#ifdef CONFIG_OSM8MP_SPI_B_CS1
	pinctrl-0 = <&pinctrl_osm_spi_b &pinctrl_osm_spi_b_cs0 &pinctrl_osm_spi_b_cs1>;
	cs-gpios = <&gpio5 13 GPIO_ACTIVE_LOW>, <&gpio3 20 GPIO_ACTIVE_LOW>;
	num-cs = <2>;
#else
	pinctrl-0 = <&pinctrl_osm_spi_b &pinctrl_osm_spi_b_cs0>;
	cs-gpios = <&gpio5 13 GPIO_ACTIVE_LOW>;
	num-cs = <1>;
#endif
	status = "okay";

	spidev@0 {
		compatible = "linux,spidev";
		spi-max-frequency = <20000000>;
		reg = <0>;
		status = "okay";
	};
};
#endif


