		pinctrl_fs_i2c_lvds_int: i2c2grp-int {
			fsl,pins = <
				MX8MP_IOMUXC_NAND_RE_B__GPIO3_IO15			0x00144
			>;
		};

		pinctrl_fs_i2c_a: i2c3grp {
			fsl,pins = <
				MX8MP_IOMUXC_I2C3_SCL__I2C3_SCL		0x400001c3
				MX8MP_IOMUXC_I2C3_SDA__I2C3_SDA		0x400001c3
			>;
