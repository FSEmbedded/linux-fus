#include <dt-bindings/usb/pd.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/phy/phy-imx8-pcie.h>

/* SOC-nodes to efus-nodes */

/* Internal nodes */
fs_emmc: &usdhc1 {};
fs_i2c_pmic: &i2c6 {};
fs_rtc_soc: &snvs_rtc {};

/* External nodes */
fs_can_a: &flexcan1 {};
fs_can_b: &flexcan2 {};
fs_csi_a: &mipi_csi_0 {};
fs_eth_a: &eqos {};
fs_eth_b: &fec {};
fs_i2c_a: &i2c3 {};
fs_i2c_b: &i2c4 {};
fs_i2c_c: &i2c5 {};
fs_i2c_e: &i2c1 {};
fs_i2c_lvds: &i2c2 {};
fs_i2s_a: &sai2 {};
fs_pcie: &pcie {};
fs_bl_pwm: &pwm3 {};
fs_pwm_a: &pwm4 {};
fs_pwm_b: &pwm1 {};
fs_sdio_a: &usdhc2 {};
fs_sdio_b: &usdhc3 {};
fs_spi_a: &ecspi3 {};
fs_spi_b: &ecspi2 {};
fs_uart_a: &uart1 {};
fs_uart_b: &uart3 {};
fs_uart_c: &uart2 {};
fs_uart_d: &uart4 {};
fs_usb_otg: &usb_dwc3_1 {};
fs_usb_host: &usb_dwc3_0 {};

/ {
	model = "F&S efusMX8MP";
	compatible = "fus,imx8mp-efusmx8mp", "fsl,imx8mp";

	/* -------------------- BOARD INFO -------------------- */
	bdinfo: bdinfo {
		compatible = "bdinfo";
		board_name = "efusmx8mp";
	};

	aliases {
		ethernet0 = &eqos;
		ethernet1 = &fec;
		spi0 = &ecspi2;
		spi1 = &ecspi3;
		i2c0 = &i2c1;
		i2c1 = &i2c2;
		i2c2 = &i2c3;
		i2c3 = &i2c4;
		i2c4 = &i2c5;
		i2c5 = &i2c6;
		rtcpcf85263 = &rtc85263;
		snvs_rtc = &snvs_rtc;
		eeprom = &eeprom;
		rgb_bridge = &rgb_bridge;
		mipi_dsi = &mipi_dsi;
		flexspi = &flexspi;
		sd_a = &usdhc2;
		sd_b = &usdhc3;
		sd_c = &usdhc1;
		adc = &adc;
	};

	reserved_mem: reserved-memory {
		/* remove this node because the region used
		 * only by tuning tool
		 */
		/delete-node/ isp0@94400000;
		/* remove these nodes because we reserve
		 * our own memory regions
		 */
		/delete-node/ dsp@92400000;
		/delete-node/ dsp_reserved_heap@93400000;
		/delete-node/ vdev0vring0@942f0000;
		/delete-node/ vdev0vring1@942f8000;
		/delete-node/ vdev0buffer@94300000;
	};

	regulators {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <0>;

		reg_vref_1v2: regulator_1v2 {
			compatible = "regulator-fixed";
			regulator-name = "vref-1V2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-always-on;
		};

		reg_vref_1v8: regulator_1v8 {
			compatible = "regulator-fixed";
			regulator-name = "vref-1V8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-always-on;
		};

		reg_vref_3v3: regulator_3v3 {
			compatible = "regulator-fixed";
			regulator-name = "vref-3V3";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			regulator-always-on;
		};
	};

	reg_fs_usb_host_vbus: regulator-usb1-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb1_host_vbus";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_fs_usb_host_pwr>;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio1 12 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		status = "disabled";
	};

	/omit-if-no-ref/
	reg_vlcd: vlcd {
		compatible = "regulator-fixed";
		regulator-name = "VLCD";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_vlcd_on>;
		gpio = <&gpio1 5 GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		status = "disabled";
	};

	/omit-if-no-ref/
	reg_ldb_bl: ldb-bl {
		compatible = "regulator-fixed";
		regulator-name = "ldb-bl";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_bl_on>;
		gpio = <&gpio1 1 GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		status = "disabled";
	};

	fs_sdio_a_pwrseq: fs_sdio_a_pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_fs_wlan_rst>;
		reset-gpios = <&gpio1 3 GPIO_ACTIVE_LOW>;
		status = "disabled";
	};

	sound-hdmi {
		compatible = "fsl,imx-audio-hdmi";
		model = "audio-hdmi";
		audio-cpu = <&aud2htx>;
		hdmi-out;
		constraint-rate = <44100>, <88200>,
				  <176400>, <32000>, <48000>, <96000>,
				  <192000>;
		status = "disabled";
	};

	extcon_usb: extcon_usb {
		compatible = "linux,extcon-usb-gpio";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_fs_usb_otg_vbus>;
		vbus-gpio = <&gpio1 14 GPIO_ACTIVE_LOW>;
		status = "disabled";
	};
};

&aud2htx {
	status = "disabled";
};

&clk {
	init-on-array = <IMX8MP_CLK_HSIO_ROOT>;
};

&A53_0 {
	cpu-supply = <&buck2>;
};

&A53_1 {
	cpu-supply = <&buck2>;
};

&A53_2 {
	cpu-supply = <&buck2>;
};

&A53_3 {
	cpu-supply = <&buck2>;
};

&fs_eth_a {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_eth_a>;
	phy-mode = "rgmii-id";
	phy-handle = <&ethphy0>;
	status = "disabled";

	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy0: ethernet-phy@4 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <4>;
			rtl821x,clkout-disable;
			rtl821x,aldps-enable;
			rtl821x,ssc-rxc-enable;
			rtl821x,ssc-sysclk-enable;
			rtl821x,ssc-clkout-enable;
			rtl821x,led-link = <2>; // LED2 for link indication
			rtl821x,led-act = <1>; // LED1 for activity
			reset-gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
			reset-assert-us = <10000>;
			reset-deassert-us = <100000>;
			interrupt-parent = <&gpio4>;
			interrupts = <3 IRQ_TYPE_LEVEL_LOW>;
			eee-broken-1000t;
		};
	};

	mtl_tx_setup: tx-queues-config {
		snps,tx-queues-to-use = <5>;
		snps,tx-sched-sp;

		queue0 {
			snps,dcb-algorithm;
			snps,priority = <0x1>;
		};

		queue1 {
			snps,dcb-algorithm;
			snps,priority = <0x2>;
		};

		queue2 {
			snps,dcb-algorithm;
			snps,priority = <0x4>;
		};

		queue3 {
			snps,dcb-algorithm;
			snps,priority = <0x8>;
		};

		queue4 {
			snps,dcb-algorithm;
			snps,priority = <0xf0>;
		};
	};

	mtl_rx_setup: rx-queues-config {
		snps,rx-queues-to-use = <5>;
		snps,rx-sched-sp;

		queue0 {
			snps,dcb-algorithm;
			snps,priority = <0x1>;
			snps,map-to-dma-channel = <0>;
		};

		queue1 {
			snps,dcb-algorithm;
			snps,priority = <0x2>;
			snps,map-to-dma-channel = <1>;
		};

		queue2 {
			snps,dcb-algorithm;
			snps,priority = <0x4>;
			snps,map-to-dma-channel = <2>;
		};

		queue3 {
			snps,dcb-algorithm;
			snps,priority = <0x8>;
			snps,map-to-dma-channel = <3>;
		};

		queue4 {
			snps,dcb-algorithm;
			snps,priority = <0xf0>;
			snps,map-to-dma-channel = <4>;
		};
	};
};

&fs_eth_b {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_eth_b>;
	phy-mode = "rgmii-id";
	phy-handle = <&ethphy1>;
	fsl,magic-packet;
	status = "disabled";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy1: ethernet-phy@5 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <5>;
			rtl821x,clkout-disable;
			rtl821x,aldps-enable;
			rtl821x,ssc-rxc-enable;
			rtl821x,ssc-sysclk-enable;
			rtl821x,ssc-clkout-enable;
			rtl821x,led-link = <2>; // LED2 for link indication
			rtl821x,led-act = <1>; // LED1 for activity
			reset-gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
			reset-assert-us = <10000>;
			reset-deassert-us = <100000>;
			interrupt-parent = <&gpio4>;
			interrupts = <2 IRQ_TYPE_LEVEL_LOW>;
			eee-broken-1000t;
		};
	};
};

&fs_bl_pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_bl_pwm>;
	#pwm-cells = <3>;
	keep-power;
	status = "disabled";
};

&fs_pwm_a {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_pwm_a>;
	status = "disabled";
};

&fs_pwm_b {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_pwm_b>;
	status = "disabled";
};

&snvs_pwrkey {
	status = "disabled";
};

&snvs_rtc {
	status = "disabled";
};

&fs_i2c_e {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_i2c_e>;
	status = "disabled";

	adc: ads1015@48 {
		compatible = "ti,ads1015";
		reg = <0x48>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";

		channel@4 {
			reg = <4>;
			ti,gain = <3>;
			ti,datarate = <5>;
		};
	};

	eeprom: eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
		pagesize = <8>;
		status = "disabled";
	};

	rtc85263: rtc85263@51 {
		compatible = "nxp,pcf85263";
		reg = <0x51>;
		clock-out = <0>; //PCF85263_CLK_OUT_32p768kHz
		status = "disabled";
		quartz-load-capacitance = <2>; //PCF85263_QUARTZCAP_12p5pF
		quartz-drive-strength = <1>; //PCF85263_QUARTZDRIVE_LOW
	};

	/* mipi to RGB controller  */
	rgb_bridge: rgb-bridge@2d {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "lontium,lt9211-fus";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_rgb_bridge>;
		reg = <0x2d>;
		reset-gpios = <&gpio4 1 GPIO_ACTIVE_HIGH>;
		/* TODO: in driver not supported */
		//interrupts-extended = <&gpio4 20 IRQ_TYPE_EDGE_FALLING>;
		vdd-supply = <&reg_vref_1v8>;
		vcc-supply = <&reg_vref_3v3>;
		status = "disabled";
	};
};

/* J2 LVDS connector -  I2C_LVDS pins 25,27 */
&fs_i2c_lvds {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_i2c_lvds>;
	status = "disabled";
};

&fs_i2c_a {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_i2c_a>;
	status = "disabled";
};

/* Goldfinger connector 82, 84, 86, 88
 * SKIT:
 *	J22 feature connector 45,46,47,48
 */
&fs_i2c_b {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_i2c_b>;
	status = "disabled";
};

/* Goldfinger connector 130, 132
 * SKIT:
 *	J6 HDMI connector 15, 16
 */
&fs_i2c_c {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_i2c_c>;
	status = "disabled";
};

&fs_i2c_pmic {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_i2c_pmic>;
	status = "disabled";

	pmic: pca9450@25 {
		reg = <0x25>;
		compatible = "nxp,pca9450c";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_pmic>;
		interrupt-parent = <&gpio4>;
		interrupts = <19 IRQ_TYPE_LEVEL_LOW>;

		regulators {
			buck1: BUCK1 {
				regulator-name = "BUCK1";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <2187500>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <3125>;
			};

			buck2: BUCK2 {
				regulator-name = "BUCK2";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <2187500>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <3125>;
				nxp,dvs-run-voltage = <950000>;
				nxp,dvs-standby-voltage = <850000>;
			};

			buck4: BUCK4 {
				regulator-name = "BUCK4";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck5: BUCK5 {
				regulator-name = "BUCK5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck6: BUCK6 {
				regulator-name = "BUCK6";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3400000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo1: LDO1 {
				regulator-name = "LDO1";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo2: LDO2 {
				regulator-name = "LDO";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1150000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo3: LDO3 {
				regulator-name = "LDO3";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo4: LDO4 {
				regulator-name = "LDO4";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo5: LDO5 {
				regulator-name = "LDO5";
				regulator-compatible = "ldo5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};
};

/* SPI_A (2x CS) */
&fs_spi_a {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_spi_a>;
	status = "disabled";
};

/* SPI_B (2x CS) */
&fs_spi_b {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_spi_b>;
	status = "disabled";
};

/* Goldfinger Connector J3 - Pins 29, 31 */
&fs_can_a {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_can_a>;
	status = "disabled";
};

&fs_can_b {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_can_b>;
	status = "disabled";
};

&fs_i2s_a {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_i2s_a>;
	assigned-clocks = <&clk IMX8MP_CLK_SAI2>;
	assigned-clock-parents = <&clk IMX8MP_AUDIO_PLL1_OUT>;
	assigned-clock-rates = <24576000>;
	clocks = <&audio_blk_ctrl IMX8MP_CLK_AUDIOMIX_SAI2_IPG>, <&clk IMX8MP_CLK_DUMMY>,
		 <&audio_blk_ctrl IMX8MP_CLK_AUDIOMIX_SAI2_MCLK1>, <&clk IMX8MP_CLK_DUMMY>,
		 <&clk IMX8MP_CLK_DUMMY>;
	clock-names = "bus", "mclk0", "mclk1", "mclk2", "mclk3";
	fsl,sai-mclk-direction-output;
	fsl,sai-mclk-always-on;
	/* sai to clock and frame tx/rx master */
	fsl,txmasterflag = <1>; // SND_SOC_DAIFMT_CBM_CFM
	fsl,rxmasterflag = <1>; // SND_SOC_DAIFMT_CBM_CFM
	status = "disabled";
};

&sdma2 {
	status = "disabled";
};

&fs_uart_a {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_uart_a>;
	status = "disabled";
};

&fs_uart_b {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_uart_b>;
	assigned-clocks = <&clk IMX8MP_CLK_UART3>;
	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_80M>;
	status = "disabled";
};

&fs_uart_c {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_uart_c>;
	assigned-clocks = <&clk IMX8MP_CLK_UART2>;
	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_80M>;
	status = "disabled";
};

&fs_uart_d {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_uart_d>;
	assigned-clocks = <&clk IMX8MP_CLK_UART4>;
	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_80M>;
	status = "disabled";
};

&fs_pcie {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_pcie>;
	reset-gpio = <&gpio4 30 GPIO_ACTIVE_LOW>;
	vpcie-supply = <&reg_vref_3v3>;
	status = "disabled";
};

&pcie_phy {
	fsl,refclk-pad-mode = <IMX8_PCIE_REFCLK_PAD_UNUSED>;
	fsl,clkreq-unsupported;
	clocks = <&hsio_blk_ctrl>;
	clock-names = "ref";
	status = "disabled";
};

/* USB1 */
&usb3_phy0 {
	vbus-supply = <&reg_fs_usb_host_vbus>;
	status = "disabled";
};

&usb3_0 {
	status = "disabled";
};

&fs_usb_host {
	dr_mode = "host";
	status = "disabled";
};

&usb3_phy1 {
	fsl,phy-tx-vref-tune = <6>;
	fsl,phy-tx-rise-tune = <0>;
	fsl,phy-tx-preemp-amp-tune = <3>;
	fsl,phy-comp-dis-tune = <7>;
	fsl,pcs-tx-deemph-3p5db = <0x21>;
	fsl,phy-pcs-tx-swing-full = <0x7f>;
	status = "disabled";
};

&usb3_1 {
	status = "disabled";
};

&fs_usb_otg {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_usb_otg>;
	extcon = <&extcon_usb>;
	dr_mode = "otg";
	hnp-disable;
	srp-disable;
	adp-disable;
	status = "disabled";
};

&fs_emmc {
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_fs_emmc>;
	pinctrl-1 = <&pinctrl_fs_emmc_100mhz>;
	pinctrl-2 = <&pinctrl_fs_emmc_200mhz>;
	non-removable;
	bus-width = <8>;
	status = "disabled";
};

&fs_sdio_a {
	pinctrl-names = "default", "state_100mhz";

	pinctrl-0 = <&pinctrl_fs_sdio_a>, <&pinctrl_fs_sdio_a_rst>;
	pinctrl-1 = <&pinctrl_fs_sdio_a_100mhz>, <&pinctrl_fs_sdio_a_rst>;

	vqmmc-supply = <&reg_vref_3v3>;
	vmmc-supply = <&reg_vref_3v3>;
	bus-width = <4>;
	status = "disabled";
};

&fs_sdio_b {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fs_sdio_b>, <&pinctrl_fs_sdio_b_gpio>;
	cd-gpios = <&gpio3 8 GPIO_ACTIVE_LOW>;
	wp-gpios = <&gpio3 9 GPIO_ACTIVE_HIGH>;

	vmmc-supply = <&reg_vref_3v3>;	/* VDD */
	vqmmc-supply = <&reg_vref_3v3>;	/* VDD_IO */
	voltage-ranges = <3300 3300>;
	no-1-8-v;
	keep-power-in-suspend;
	bus-width = <4>;
	status = "disabled";
};

&flexspi {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexspi0>;
	status = "disabled";

	flash0: f50l2g41lb@2 {
		reg = <2>;
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "spi-nand";
		spi-max-frequency = <104000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
		status = "disabled";
	};
};

&fs_csi_a {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "disabled";
};

&wdog1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_wdog>;
	fsl,ext-reset-output;
	status = "disabled";
};

&irqsteer_hdmi {
	status = "disabled";
};

&hdmi_pavi {
	status = "disabled";
};

&hdmi {
	status = "disabled";
};

&hdmiphy {
	status = "disabled";
};

&hdmi_blk_ctrl {
	status = "disabled";
};

&lcdif1 {
	status = "disabled";
};

&lcdif2 {
	status = "disabled";
};

&lcdif3 {
	status = "disabled";
	thres-low  = <1 2>;             /* (FIFO * 1 / 2) */
	thres-high = <3 4>;             /* (FIFO * 3 / 4) */

};

&easrc {
	status = "disabled";
};

&vpu_g1 {
	status = "disabled";
};

&vpu_g2 {
	status = "disabled";
};

&vpu_vc8000e {
	status = "disabled";
};

&vpu_v4l2 {
	status = "disabled";
};

&gpu_3d {
	status = "disabled";
};

&gpu_2d {
	status = "disabled";
};

&ml_vipsi {
	status = "disabled";
};

&mix_gpu_ml {
	status = "disabled";
};

&dsp {
	/delete-property/ memory-region;
	status = "disabled";
};

&dewarp {
	status = "disabled";
};

/* GPIO declarations */
&gpio1 {
	gpio-line-names =
	/* 0 */  "SE050_ENA", "BL_ON", "PMIC_WDOG", "WLAN_RST",
	/* 4 */  "SD_A_VSEL", "VLCD_ON", "LVDS_RST", "ETH_B_PHY_RST",
	/* 8 */  "I2C_A_RST", "I2C_A_IRQ", "BL_PWM", "ETH_A_PHY_RST",
	/* 12 */ "USB_HOST_PWR", "RESETOUT", "USB_OTG_PWR", "USB_OTG_OC",
	/* 16 */ "ENET_QOS_MDC", "ENET_QOS_MDIO", "ENET_QOS_TXD3", "ENET_QOS_TXD2",
	/* 20 */ "ENET_QOS_TXD1", "ENET_QOS_TXD0", "ENET_QOS_TX_CTL", "ENET_QOS_TXC_R",
	/* 24 */ "ENET_QOS_RX_CTL", "ENET_QOS_RXC_R", "ENET_QOS_RXD0", "ENET_QOS_RXD1",
	/* 28 */ "ENET_QOS_RXD2", "ENET_QOS_RXD3", "", "";
	status = "disabled";
};

&gpio2 {
	gpio-line-names =
	/* 0 */  "SD_C_CLK", "SD_C_CMD", "SD_C_DATA0", "SD_C_DATA1",
	/* 4 */  "SD_C_DATA2", "SD_C_DATA3", "SD_C_DATA4", "SD_C_DATA5",
	/* 8 */  "SD_C_DATA6", "SD_C_DATA7", "SD_C_RESET_B", "SD_C_STROBE",
	/* 12 */ "SD_A_CD", "SD_A_CLK", "SD_A_CMD", "SD_A_DATA0",
	/* 16 */ "SD_A_DATA1", "SD_A_DATA2", "SD_A_DATA3", "SD_A_RST",
	/* 20 */ "SD_A_WP", "", "", "",
	/* 24 */ "", "", "", "",
	/* 28 */ "", "", "", "";
	status = "disabled";
};

&gpio3 {
	gpio-line-names =
	/* 0 */  "SPI_A_IRQ2", "SPI_A_SS1", "SPI_B_IRQ2", "QSPI_NAND_SS0",
	/* 4 */  "SPI_B_IRQ1", "QSPI_NAND_SCLK", "UART_D_RXD", "UART_D_TXD",
	/* 8 */  "SD_B_CD", "SD_B_WP", "QSPI_NAND_DATA0", "QSPI_NAND_DATA1",
	/* 12 */ "QSPI_NAND_DATA2", "QSPI_NAND_DATA3", "SPI_A_IRQ1", "I2C_LVDS_IRQ/VLCDON",
	/* 16 */ "SPI_B_SS1", "SD_B_CLK", "SD_B_CMD", "I2C_PMIC_SCL",
	/* 20 */ "I2C_PMIC_SDA", "PCM_IN", "PCM_SYNC", "PCM_CLK",
	/* 24 */ "PCM_OUT", "", "I2C_C_SCL", "I2C_C_SDA",
	/* 28 */ "HDMI_CEC", "HDMI_HPD", "", "";
	status = "disabled";
};

&gpio4 {
	gpio-line-names =
	/* 0 */  "I2C_E_IRQ", "DISP_RST", "ETH_B_PHY_INT", "ETH_A_PHY_INT",
	/* 4 */  "RGMII_MDC", "RGMII_MDIO", "RGMII_RXD0", "RGMII_RXD1",
	/* 8 */  "RGMII_RXD2", "RGMII_RXD3", "RGMII_RX_CTL", "RGMII_RXC_R",
	/* 12 */ "RGMII_TXD0", "RGMII_TXD1", "RGMII_TXD2", "RGMII_TXD3",
	/* 16 */ "RGMII_TX_CTL", "RGMII_TXC", "", "PMIC_IRQ_B",
	/* 20 */ "DISP_INT", "UART_A_TXD", "UART_A_RXD", "I2S_A_RXD",
	/* 24 */ "I2S_A_TXFS", "I2S_A_TXC", "I2S_A_TXD", "I2S_A_MCLK",
	/* 28 */ "I2C_B_RST", "I2C_B_IRQ", "mPCIE_PERST", "UART_C_RXD";
