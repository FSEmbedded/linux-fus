};

&gpio5 {
	gpio-line-names =
	/* 0 */  "UART_C_TXD", "mPCIE_WAKE", "SAI3_MCLK", "CAN_A_TX",
	/* 4 */  "CAN_A_RX", "PWM_B", "UART_B_RXD", "UART_B_TXD",
	/* 8 */  "UART_B_RTS", "UART_B_CTS", "SPI_B_SCLK", "SPI_B_MOSI",
	/* 12 */ "SPI_B_MISO", "SPI_B_SS0", "I2C_E_SCL", "I2C_E_SDA",
	/* 16 */ "I2C_LVDS_SCL", "I2C_LVDS_SDA", "I2C_A_SCL", "I2C_A_SDA",
	/* 20 */ "I2C_B_SCL", "I2C_B_SDA", "SPI_A_SCLK", "SPI_A_MOSI",
