&cameradev {
	status = "disabled";
};

&isp_0 {
	/* remove this property because this region used
	 * only by tuning tool
	 * */
	/delete-property/ memory-region;
};

&isi_0 {
	status = "disabled";

	cap_device {
		status = "disabled";
	};

	m2m_device {
		status = "disabled";
	};
};

&isi_1 {
	status = "disabled";

	cap_device {
		status = "disabled";
	};
};

&dsp {
	/delete-property/ memory-region;
	status = "disabled";
};

&snvs_pwrkey {
	status = "disabled";
};

/* Disable CPU RTC - external available */
&rtc_soc {
	status = "disabled";
};

/* GPIO declarations */
&gpio1 {
	gpio-line-names =
	/* 0 */   "GPIO_B_2", "GPIO_A_3", "WDOG", "GPIO_B_0",
	/* 4 */   "SDIO_A_VSEL", "GPIO_A_0", "GPIO_A_1", "GPIO_A_2",
	/* 8 */   "GPIO_A_5", "GPIO_B_3", "GPIO_A_4", "GPIO_B_1",
	/* 12 */  "USB_A_EN", "USB_A_OC", "USB_C_EN", "USB_C_OC",
	/* 16 */  "ETH_A_MDC", "ETH_A_MDIO", "ETH_A_(S)(R)(G)MII_TXD3", "ETH_A_(S)(R)(G)MII_TXD2",
