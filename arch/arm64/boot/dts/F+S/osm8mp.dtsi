&osm_can_a {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_osm_can_a>;
	status = "disabled";
};

&osm_can_b {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_osm_can_b>;
	status = "disabled";
};

&hdmi_blk_ctrl {
	status = "disabled";
};

&irqsteer_hdmi {
	status = "disabled";
};

&hdmi_pavi {
	status = "disabled";
};

&hdmi {
	status = "disabled";
};

&hdmiphy {
	status = "disabled";
};

&lcdif1 {
	status = "disabled";
};

&lcdif2 {
	status = "disabled";
};

&lcdif3 {
	status = "disabled";
};

&ldb {
	status = "disabled";
};

&ldb_phy {
	status = "disabled";
};

&mipi_dsi {
	status = "disabled";
};

&easrc {
	status = "disabled";
};

&osm_pcie_a {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_osm_pcie_a>;
	reset-gpio = <&gpio4 29 GPIO_ACTIVE_LOW>;
	status = "disabled";
};

&pcie_phy {
	fsl,refclk-pad-mode = <IMX8_PCIE_REFCLK_PAD_UNUSED>;
	fsl,clkreq-unsupported;
	clocks = <&hsio_blk_ctrl>;
	clock-names = "ref";
	status = "disabled";
};

&osm_i2s_a {
	#sound-dai-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_osm_i2s_a>;
	assigned-clocks = <&clk IMX8MP_CLK_SAI2>;
	assigned-clock-rates = <24576000>;
	clocks = <&audio_blk_ctrl IMX8MP_CLK_AUDIOMIX_SAI2_IPG>, <&clk IMX8MP_CLK_DUMMY>,
		 <&audio_blk_ctrl IMX8MP_CLK_AUDIOMIX_SAI2_MCLK1>, <&clk IMX8MP_CLK_DUMMY>,
		 <&clk IMX8MP_CLK_DUMMY>;
	clock-names = "bus", "mclk0", "mclk1", "mclk2", "mclk3";
	fsl,sai-mclk-direction-output;
	/* sai to clock and frame tx/rx master */
	fsl,txmasterflag = <1>; // SND_SOC_DAIFMT_CBM_CFM
	fsl,rxmasterflag = <1>; // SND_SOC_DAIFMT_CBM_CFM
	status = "disabled";
};

&osm_i2s_b {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_osm_i2s_b>;
	assigned-clocks = <&clk IMX8MP_CLK_SAI3>;
	assigned-clock-rates = <24576000>;
	clocks = <&audio_blk_ctrl IMX8MP_CLK_AUDIOMIX_SAI3_IPG>, <&clk IMX8MP_CLK_DUMMY>,
		 <&audio_blk_ctrl IMX8MP_CLK_AUDIOMIX_SAI3_MCLK1>, <&clk IMX8MP_CLK_DUMMY>,
		 <&clk IMX8MP_CLK_DUMMY>;
	clock-names = "bus", "mclk0", "mclk1", "mclk2", "mclk3";
	fsl,sai-mclk-direction-output;
	fsl,txmasterflag = <1>; // SND_SOC_DAIFMT_CBM_CFM
	fsl,rxmasterflag = <1>; // SND_SOC_DAIFMT_CBM_CFM
	status = "disabled";
};

&sdma2 {
	status = "disabled";
};

&osm_uart_con {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_osm_uart_con>;
	status = "disabled";
};

&osm_uart_a {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_osm_uart_a>;
	status = "disabled";
};

&osm_uart_b {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_osm_uart_b>;
	status = "disabled";
};

&osm_uart_c {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_osm_uart_c>;
	status = "disabled";
};

&usb3_phy0 {
	fsl,phy-tx-vref-tune = <0xe>;
	fsl,phy-tx-preemp-amp-tune = <3>;
	fsl,phy-tx-vboost-level = <5>;
	fsl,phy-comp-dis-tune = <7>;
	fsl,pcs-tx-deemph-3p5db = <0x21>;
	fsl,phy-pcs-tx-swing-full = <0x7f>;
	status = "disabled";
};

&usb3_0 {
	status = "disabled";
};

&osm_usb_a {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_osm_usb_a>;
	dr_mode = "otg";
	hnp-disable;
	srp-disable;
	adp-disable;
	usb-role-switch;
	role-switch-default-mode = "none";
	status = "disabled";
};

&usb3_phy1 {
	fsl,phy-tx-preemp-amp-tune = <3>;
	fsl,phy-tx-vref-tune = <0xb>;
	status = "disabled";
};

&usb3_1 {
	status = "disabled";
};

&osm_usb_c {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_osm_usb_c>;
	status = "disabled";
};

&osm_sdio_a {
	assigned-clocks = <&clk IMX8MP_CLK_USDHC2>;
	assigned-clock-rates = <400000000>;
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_osm_sdio_a>;
	pinctrl-1 = <&pinctrl_osm_sdio_a_100mhz>;
	pinctrl-2 = <&pinctrl_osm_sdio_a_200mhz>;
	bus-width = <4>;
	status = "disabled";
};

&osm_sdio_b {
	assigned-clocks = <&clk IMX8MP_CLK_USDHC3>;
	assigned-clock-rates = <400000000>;
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_osm_sdio_b>;
	pinctrl-1 = <&pinctrl_osm_sdio_b_100mhz>;
	pinctrl-2 = <&pinctrl_osm_sdio_b_200mhz>;
	vqmmc-supply = <&reg_vref_1v8>;
	status = "disabled";
};

&emmc {
	assigned-clocks = <&clk IMX8MP_CLK_USDHC1>;
	assigned-clock-rates = <400000000>;
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_emmc>;
	pinctrl-1 = <&pinctrl_emmc_100mhz>;
	pinctrl-2 = <&pinctrl_emmc_200mhz>;
	vmmc-supply = <&reg_vref_3v3>;
	vqmmc-supply = <&reg_vref_1v8>;
	bus-width = <8>;
	non-removable;
	status = "disabled";
};

&osm_csi {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "disabled";
};

&wdog1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_wdog>;
	fsl,ext-reset-output;
	status = "disabled";
};

&vpu_g1 {
	status = "disabled";
};

&vpu_g2 {
	status = "disabled";
};

&vpu_vc8000e {
	status = "disabled";
};

&vpu_v4l2 {
	status = "disabled";
