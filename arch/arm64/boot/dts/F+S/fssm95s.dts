&gpio2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio_test>;
};

&tpm4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_tpm4>;
	status = "okay";
};

&elemu1 {
    status = "disabled";
};

&elemu2 {
    status = "disabled";
};

/* only MU_ELE3 and MU_ELE4 are listed under non-secure in cfg*/
&elemu3 {
    status = "okay";
};

