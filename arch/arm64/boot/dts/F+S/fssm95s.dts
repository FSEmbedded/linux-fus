/dts-v1/;

#include <dt-bindings/i3c/i3c.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/phy/phy-imx8-pcie.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/usb/pd.h>
#include "../freescale/imx95.dtsi"

#define DEV_SM_NUM_CTRL             0x8000

#define BRD_SM_CTRL_T_SENSE_EV_n    (DEV_SM_NUM_CTRL +  0)  /*!< PCAL6524 Pin  1 */
#define BRD_SM_CTRL_BATLOW_n        (DEV_SM_NUM_CTRL +  1)  /*!< PCAL6524 Pin  2 */
#define BRD_SM_CTRL_CHARGER_PRSNT_n (DEV_SM_NUM_CTRL +  2)  /*!< PCAL6524 Pin  3 */
#define BRD_SM_CTRL_CHARGING_n      (DEV_SM_NUM_CTRL +  3)  /*!< PCAL6524 Pin  4 */
#define BRD_SM_CTRL_SMB_ALERT_n     (DEV_SM_NUM_CTRL +  4)  /*!< PCAL6524 Pin  5 */
#define BRD_SM_CTRL_TEST_n          (DEV_SM_NUM_CTRL +  5)  /*!< PCAL6524 Pin  6 */
#define BRD_SM_CTRL_SLEEP_n         (DEV_SM_NUM_CTRL +  6)  /*!< PCAL6524 Pin  7 */
#define BRD_SM_CTRL_LID_n           (DEV_SM_NUM_CTRL +  7)  /*!< PCAL6524 Pin  8 */
#define BRD_SM_CTRL_SEC_EN_IRQ_n    (DEV_SM_NUM_CTRL +  8)  /*!< PCAL6524 Pin  9 */
#define BRD_SM_CTRL_PCIe_A_WAKE_n   (DEV_SM_NUM_CTRL +  9)  /*!< PCAL6524 Pin 14 */
#define BRD_SM_CTRL_WLAN_WAKE_HOST  (DEV_SM_NUM_CTRL + 10)  /*!< PCAL6524 Pin 18 */
#define BRD_SM_CTRL_BT_WAKE_HOST    (DEV_SM_NUM_CTRL + 11)  /*!< PCAL6524 Pin 20 */
#define BRD_SM_CTRL_SN65DSI86_INT   (DEV_SM_NUM_CTRL + 12)  /*!< PCAL6524 Pin 21 */

fs_i2c_pm: &lpi2c2 {};
fs_i2c_gp: &lpi2c8 {};
fs_i2c_lcd: &lpi2c5 {};
fs_i2c_cam_a_lcd: &lpi2c3 {};
fs_i2c_cam_b: &lpi2c6 {};
fs_i2c_int: &lpi2c4 {};
fs_uart_a: &lpuart1 {};
fs_uart_b: &lpuart8 {};
fs_uart_c: &lpuart5 {};
fs_uart_d: &lpuart3 {};
emmc: &usdhc1 {};
fs_sdio_sd: &usdhc2 {};
fs_spi_a: &lpspi4 {};
fs_qspi: &flexspi1 {};
fs_eth_a: &enetc_port0 {};
fs_eth_b: &enetc_port1 {};
fs_csi0: &mipi_csi0 {};
fs_can0: &flexcan1 {};
fs_can1: &flexcan3 {};


/ {
	model = "F&S SMARC95S";
	compatible = "fsl,imx95-15x15-evk", "fsl,imx95";

	chosen {
		bootargs = "console=ttyLP0,115200";
		stdout-path = &fs_uart_a;
	};

	aliases {
		gpio0 = &gpio1;
		gpio1 = &gpio2;
		gpio2 = &gpio3;
		gpio3 = &gpio4;
		gpio4 = &gpio5;
		i2c0 = &fs_i2c_pm;
		i2c1 = &fs_i2c_gp;
		i2c2 = &fs_i2c_cam_a_lcd;
		i2c3 = &fs_i2c_cam_b;
		i2c4 = &fs_i2c_int;
		mmc0 = &emmc;
		mmc1 = &usdhc2;
		mmc2 = &usdhc3;
		serial0 = &fs_uart_a;
		serial1 = &fs_uart_b;
		serial2 = &fs_uart_c;
		serial3 = &fs_uart_d;
		ethernet0 = &fs_eth_a;
		ethernet1 = &fs_eth_b;
		spi0 = &fs_spi_a;
		spi1 = &fs_qspi;
		can0 = &fs_can0;
		can1 = &fs_can1;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <
			0x0 0x80000000 0x0 0x80000000
			0x1 0x00000000 0x1 0x80000000
		>;
	};

	mali_pma: protected-memory-allocator {
		 compatible = "arm,protected-memory-allocator";
		 memory-region = <&mali_protected>;
	};

	reserved-memory {
		ranges;
		#address-cells = <2>;
		#size-cells = <2>;

		linux_cma: linux,cma {
			compatible = "shared-dma-pool";
			alloc-ranges = <0 0x80000000 0 0x7F000000>;
			reusable;
			size = <0 0x3c000000>;
			linux,cma-default;
		};

		vdev0vring0: vdev0vring0@88000000 {
			reg = <0 0x88000000 0 0x8000>;
			no-map;
		};

		vdev0vring1: vdev0vring1@88008000 {
			reg = <0 0x88008000 0 0x8000>;
			no-map;
		};

		vdev1vring0: vdev1vring0@88010000 {
			reg = <0 0x88010000 0 0x8000>;
			no-map;
		};

		vdev1vring1: vdev1vring1@88018000 {
			reg = <0 0x88018000 0 0x8000>;
			no-map;
		};

		vdevbuffer: vdevbuffer@88020000 {
			compatible = "shared-dma-pool";
			reg = <0 0x88020000 0 0x100000>;
			no-map;
		};

		rsc_table: rsc-table@88220000 {
			reg = <0 0x88220000 0 0x1000>;
			no-map;
		};

		vpu_boot: vpu_boot@a0000000 {
			reg = <0 0xa0000000 0 0x100000>;
			no-map;
		};

		mali_protected: mali_protected {
			reg = <0 0xa0100000 0 0x1000000>;
			no-map;
		};
	};
	/*
	dp_connector: dp-connector {
		compatible = "dp-connector";
		type = "full-size";

		port {
			dp_connector_in: endpoint {
				remote-endpoint = <&sn65dsi86_out>;
			};
		};
	};*/

	t_sense_emmc: thermistor-1 {
		/* "epcos,b57330v2103" has the same B values as Panasonic ERT-JZEG103FA */
		compatible = "epcos,b57330v2103";
		io-channels = <&adc1 2>;
		pullup-uv = <1800000>;
		pullup-ohm = <10000>;
		pulldown-ohm = <0>;
		#thermal-sensor-cells = <0>;
    };

	t_sense_pf09: thermistor-2 {
		/* "epcos,b57330v2103" has the same B values as Panasonic ERT-JZEG103FA */
		compatible = "epcos,b57330v2103";
		io-channels = <&adc1 3>;
		pullup-uv = <1800000>;
		pullup-ohm = <10000>;
		pulldown-ohm = <0>;
		#thermal-sensor-cells = <0>;
    };

	t_sense_pf53: thermistor-3 {
		/* "epcos,b57330v2103" has the same B values as Panasonic ERT-JZEG103FA */
		compatible = "epcos,b57330v2103";
		io-channels = <&adc1 4>;
		pullup-uv = <1800000>;
		pullup-ohm = <10000>;
		pulldown-ohm = <0>;
		#thermal-sensor-cells = <0>;
    };

	reg_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		regulator-name = "+V3.3_SW";
		regulator-always-on;
	};

	reg_vref_1v8: regulator_1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vref-1V8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	reg_usdhc2_vmmc: regulator-usdhc2 {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_reg_usdhc2_vmmc>;
		regulator-name = "VDD_SD2_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio3 7 GPIO_ACTIVE_HIGH>;
		off-on-delay-us = <12000>;
		enable-active-high;
	};

	reg_usb_a_vbus: regulator-usb-a-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_a_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&expander 7 GPIO_ACTIVE_HIGH>; /* P0_7 controls USB_A_EN_3v3*/
		enable-active-high;
	};

	reg_m2_pwr: regulator-m2-pwr {
		compatible = "regulator-fixed";
		regulator-name = "M.2-power";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&expander 10 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};

	reg_vlcd: vlcd {
		compatible = "regulator-fixed";
		regulator-name = "VLCD_ON";
		gpio = <&expander 8 GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
	};

	reg_bridge_1v2: regulator-bridge-1v2 {
		compatible = "regulator-fixed";
		regulator-name = "SN65DSI86_1V2";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		regulator-always-on;
	};

	reg_bridge_1v8: regulator-bridge-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "SN65DSI86_1V8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	usb_host_reset: gpio-reset {
		compatible = "gpio-reset";
		reset-gpios = <&expander 2 GPIO_ACTIVE_LOW>;
		reset-delay-us = <1000>;
		#reset-cells = <0>;
	};

	/* SE050 power on voltage */
	reg_vref_se050: regulator_se050 {
		compatible = "regulator-fixed";
		regulator-name = "SE050_IRQ";
		gpio = <&pcal6524 8 GPIO_ACTIVE_LOW>;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		enable-active-high;
		status = "disabled";
	};
};

&adc1 {
	vref-supply = <&reg_vref_1v8>;
	status = "okay";
};

&fs_qspi {
	num-cs = <2>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexspi1 &pinctrl_flexspi1_spi_cs>;
	//assigned-clock-rates = <80000000>;
	status = "disabled";

	spidev@0 {
		compatible = "linux,spidev";
		reg = <0>;
		spi-max-frequency = <20000000>;
		status = "okay";
	};

	spidev@1 {
		compatible = "linux,spidev";
		reg = <1>;
		spi-max-frequency = <20000000>;
		status = "okay";
	};
};

&fs_spi_a {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpspi4 &pinctrl_lpspi4_cs>;
	cs-gpios = <&gpio2 18 GPIO_ACTIVE_LOW>, <&gpio2 17 GPIO_ACTIVE_LOW>;
	num-cs = <2>;
	status = "okay";

	spidev@0 {
		compatible = "linux,spidev";
		spi-max-frequency = <20000000>;
		reg = <0>;
		status = "okay";
	};

	spidev@1 {
		compatible = "linux,spidev";
		spi-max-frequency = <20000000>;
		reg = <1>;
		status = "okay";
	};
};

&flexcan1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexcan1>;
	status = "disabled";
};

&flexcan3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexcan3>;
	status = "disabled";
};

&sai2 {
    status = "disabled";
};

&fs_i2c_gp {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpi2c8>;
	status = "okay";

	eeprom: eeprom@50 {
		compatible = "onnn,n24s64b", "atmel,24c64";
		reg = <0x50>;
		size = <8192>;
		pagesize = <32>;
	};
};

&fs_i2c_pm {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpi2c2>;
	status = "disabled";

	pcal6524: gpio@22 {
		compatible = "nxp,pcal6524";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_pcal6524>;
		reg = <0x22>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio5>;
		interrupts = <14 IRQ_TYPE_LEVEL_LOW>;
		status = "disabled";
	};
};

&fs_i2c_lcd {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpi2c5>;
	status = "disabled";
};


&fs_i2c_int {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpi2c4>;
	status = "okay";

    expander: gpio@21 {
        compatible = "nxp,pcal6416";
        reg = <0x21>;

        vcc-supply = <&reg_vref_1v8>;

        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <16>;
        pcal6416,port0-open-drain;
        gpio-line-names =
            "bt_rst",
            "wlan_rst",
            "usb_hub_rst",
            "wlan_bt_pd",
            "usb_c_en",
            "eth_a_phy_rst",
            "eth_b_phy_rst",
            "usb_a_en",
            "lvds_a_vdd_en",
            "lvds_a_bl_en",
            "lvds_b_vdd_en",
            "lvds_b_bl_en",
            "pcie_rst",
            "sn65dsi86_en",
            "wlan_wake_dev",
            "bt_wake_dev";
    };
};

&lpi2c5 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpi2c5>;
	status = "disabled";
};

/* M33 and A55 */
&fs_uart_a {
	/* console */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

&fs_uart_b {
    status = "disabled";
};

&fs_uart_c {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart5>;
	fsl,uart-has-rtscts;
    status = "okay";
};

/* M7 */
&fs_uart_d {
    status = "disabled";
};

&usdhc1 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_usdhc1>;
	pinctrl-1 = <&pinctrl_usdhc1_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc1_200mhz>;
	bus-width = <8>;
	non-removable;
	no-sdio;
	no-sd;
	status = "okay";
};

&usdhc2 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
	pinctrl-1 = <&pinctrl_usdhc2_100mhz>, <&pinctrl_usdhc2_gpio>;
	pinctrl-2 = <&pinctrl_usdhc2_200mhz>, <&pinctrl_usdhc2_gpio>;
	cd-gpios = <&gpio3 00 GPIO_ACTIVE_LOW>;
	vmmc-supply = <&reg_usdhc2_vmmc>;
	bus-width = <4>;
	status = "okay";
};

&netc_bus0 {
	msi-map = <0x0 &its 0x60 0x1>,	//ENETC0 PF
		  <0x10 &its 0x61 0x1>, //ENETC0 VF0
		  <0x20 &its 0x62 0x1>, //ENETC0 VF1
		  <0x40 &its 0x63 0x1>, //ENETC1 PF
		  <0x50 &its 0x65 0x1>, //ENETC1 VF0
		  <0x60 &its 0x66 0x1>, //ENETC1 VF1
		  <0x80 &its 0x64 0x1>, //ENETC2 PF
		  <0xc0 &its 0x67 0x1>; //NETC Timer
	iommu-map = <0x0 &smmu 0x20 0x1>,
		    <0x10 &smmu 0x21 0x1>,
		    <0x20 &smmu 0x22 0x1>,
		    <0x40 &smmu 0x23 0x1>,
		    <0x50 &smmu 0x25 0x1>,
		    <0x60 &smmu 0x26 0x1>,
		    <0x80 &smmu 0x24 0x1>,
		    <0xc0 &smmu 0x27 0x1>;
};

&fs_eth_a {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enetc0>;
	phy-handle = <&ethphy0>;
	phy-mode = "rgmii-id";
	status = "okay";
};

&fs_eth_b {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enetc1>;
	phy-handle = <&ethphy1>;
	phy-mode = "rgmii-id";
	status = "okay";
};


&mali {
	protected-memory-allocator = <&mali_pma>;
};


&mu7 {
	status = "okay";
};

&netc_blk_ctrl {
	status = "okay";
};

&netcmix_blk_ctrl {
	status = "okay";
};

&netc_timer {
	status = "okay";
};


&netc_emdio {
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_emdio>;
    status = "okay";

    ethphy0: ethernet-phy@4 {
        reg = <4>;
		/* RTL8211FDI : 001c.c916 */
		compatible = "ethernet-phy-id001c.c916";
        interrupt-parent = <&gpio4>;
        interrupts = <15 IRQ_TYPE_LEVEL_LOW>;
        reset-gpios = <&expander 5 GPIO_ACTIVE_LOW>;
        reset-assert-us = <50000>;
        reset-deassert-us = <150000>;
    };

    ethphy1: ethernet-phy@5 {
        reg = <5>;
		/* RTL8211FDI : 001c.c916 */
		compatible = "ethernet-phy-id001c.c916";
        interrupt-parent = <&gpio4>;
        interrupts = <14 IRQ_TYPE_LEVEL_LOW>;
        reset-gpios = <&expander 6 GPIO_ACTIVE_LOW>;
        reset-assert-us = <50000>;
        reset-deassert-us = <150000>;
    };
};

&i3c2 {
    status = "disabled";
};

&usb2 {
    status = "okay";
    vbus-supply = <&reg_usb_a_vbus>;
    disable-over-current;
};

&displaymix_irqsteer {
	status = "okay";
};

&dpu {
	status = "okay";
};

&usb3_phy {
	status = "okay";
	/delete-property/ orientation-switch;
	fsl,tca-reverse-orientation;
};

/* USB3_GLUE */
&usb3 { status = "okay"; };
&usb3_dwc3 {
    resets = <&usb_host_reset>;
    status = "okay";
    dr_mode = "host";
    /* vbus on wired to 3v3 */
    disable-over-current;
	hnp-disable;
    srp-disable;
    adp-disable;
    snps,dis-u1-entry-quirk;
    snps,dis-u2-entry-quirk;
	fsl,permanently-attached; /* USB hub is permanently attached */
};

&pcie0 {
	pinctrl-0 = <&pinctrl_pcie0>;
	pinctrl-names = "default";
	fsl,refclk-pad-mode = <IMX8_PCIE_REFCLK_PAD_OUTPUT>;
	reset-gpio = <&expander 12 GPIO_ACTIVE_HIGH>;
	vpcie-supply = <&reg_m2_pwr>;
	/delete-property/ supports-clkreq;
	status = "okay";
};

&vpuctrl {
	boot = <&vpu_boot>;
	sram = <&sram1>;
};

&thermal_zones {
	pf09 {
		polling-delay-passive = <250>;
		polling-delay = <2000>;
		thermal-sensors = <&scmi_sensor 2>;
		trips {
			pf09_alert: trip0 {
				temperature = <140000>;
				hysteresis = <2000>;
				type = "passive";
			};

			pf09_crit: trip1 {
				temperature = <155000>;
				hysteresis = <2000>;
				type = "critical";
			};
		};
	};

	pf53_soc {
		polling-delay-passive = <250>;
		polling-delay = <2000>;
		thermal-sensors = <&scmi_sensor 3>;
		trips {
			pf5302_alert: trip0 {
				temperature = <140000>;
				hysteresis = <2000>;
				type = "passive";
			};

			pf5302_crit: trip1 {
				temperature = <155000>;
				hysteresis = <2000>;
				type = "critical";
			};
		};
	};

	pf53_arm {
		polling-delay-passive = <250>;
		polling-delay = <2000>;
		thermal-sensors = <&scmi_sensor 4>;
		trips {
			pf5301_alert: trip0 {
				temperature = <140000>;
				hysteresis = <2000>;
				type = "passive";
			};

			pf5301_crit: trip1 {
				temperature = <155000>;
				hysteresis = <2000>;
				type = "critical";
			};
		};
	};

	p3t1755 {
		polling-delay-passive = <250>;
		polling-delay = <2000>;
		thermal-sensors = <&scmi_sensor 5>;
		trips {
			p3t1755_alert: trip0 {
				temperature = <80000>;
				hysteresis = <2000>;
				type = "passive";
			};

			p3t1755_crit: trip1 {
				temperature = <105000>;
				hysteresis = <2000>;
				type = "critical";
			};
		};
	};

	emmc_ntc {
		polling-delay-passive = <1000>;
		polling-delay = <2000>;
		thermal-sensors = <&t_sense_emmc>;
		trips {
			emmc_crit: trip0 {
				temperature = <125000>;
				hysteresis = <2000>;
				type = "critical";
			};
		};
	};

	pf09_ntc {
		polling-delay-passive = <1000>;
		polling-delay = <2000>;
		thermal-sensors = <&t_sense_pf09>;
		trips {
			pf09_ntc_crit: trip0 {
				temperature = <125000>;
				hysteresis = <2000>;
				type = "critical";
			};
		};
	};

	pf53_ntc {
		polling-delay-passive = <1000>;
		polling-delay = <2000>;
		thermal-sensors = <&t_sense_pf53>;
		trips {
			pf53_ntc_crit: trip0 {
				temperature = <125000>;
				hysteresis = <2000>;
				type = "critical";
			};
		};
	};
};


