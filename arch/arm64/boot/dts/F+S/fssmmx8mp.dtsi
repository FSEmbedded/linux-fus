#include <dt-bindings/usb/pd.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/rtc/nxp,pcf85263.h>
#include <dt-bindings/phy/phy-imx8-pcie.h>

/* SOC-nodes to SMARC-nodes */

/* Internal nodes */
emmc: &usdhc1 {};
i2c_int: &i2c6 {};
rtc_soc: &snvs_rtc {};
sd_wlan: &usdhc3 {};

/* External nodes */
sm_can0: &flexcan1 {};
sm_can1: &flexcan2 {};
sm_csi0: &mipi_csi_0 {};
sm_csi1: &mipi_csi_1 {};
sm_gbe0: &eqos {};
sm_gbe1: &fec {};
sm_i2c_cam0: &i2c1 {};
sm_i2c_cam1: &i2c2 {};
sm_i2c_gp: &i2c3 {};
sm_i2c_pm: &i2c4 {};
sm_i2c_lcd: &i2c5 {};
sm_i2s0: &sai2 {};
sm_i2s2: &sai3 {};
sm_pcie: &pcie {};
sm_pwm_out: &pwm1 {};
sm_lcd0_bklt_pwm: &pwm4 {};
sm_lcd1_bklt_pwm: &pwm2 {};
sm_sdio: &usdhc2 {};
sm_spi0: &ecspi1 {};
sm_spi1: &ecspi2 {};
sm_ser0: &uart2 {};
sm_ser1: &uart1 {};
sm_ser2: &uart4 {};
sm_ser3: &uart3 {};
sm_usb0: &usb_dwc3_0 {};
sm_usb1: &usb_dwc3_1 {};
/* sm_usb2: sm_usb1 over HUB if mounted */
/* sm_usb3: sm_usb1 over HUB if mounted */
/* sm_usb4: sm_usb1 over HUB if mounted */

/ {
	model = "F&S FSSMMX8MP";
	compatible = "fus,imx8mp-fssmmx8mp", "fsl,imx8mp";

	bdinfo: bdinfo {
		compatible = "bdinfo";
		board_name = "fssmmx8mp";
	};

	aliases {
		ethernet0 = &eqos;
		ethernet1 = &fec;
		spi0 = &ecspi1;
		spi1 = &ecspi2;
		i2c0 = &i2c1;
		i2c1 = &i2c2;
		i2c2 = &i2c3;
		i2c3 = &i2c4;
		i2c4 = &i2c5;
		i2c5 = &i2c6;
		eeprom = &eeprom;
		wlan = &mwifiex;
		wlan-reset = &reg_wlan_pdn;
	};

	reserved_mem: reserved-memory {
		/* remove this node because the region used
		 * only by tuning tool
		 * */
		/delete-node/isp0@94400000;
		/* remove these nodes because we reserve
		 * our own memory regions
		 * */
		/delete-node/dsp@92400000;
		/delete-node/dsp_reserved_heap@93400000;
		/delete-node/vdev0vring0@942f0000;
		/delete-node/vdev0vring1@942f8000;
		/delete-node/vdev0buffer@94300000;
	};

	regulators {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <0>;

		reg_vref_1v2: regulator_1v2 {
			compatible = "regulator-fixed";
			regulator-name = "vref-1V2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-always-on;
		};

		reg_vref_1v8: regulator_1v8 {
			compatible = "regulator-fixed";
			regulator-name = "vref-1V8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-always-on;
		};

		reg_vref_3v3: regulator_3v3 {
			compatible = "regulator-fixed";
			regulator-name = "vref-3V3";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			regulator-always-on;
		};
	};

	/* LCD0 power on voltage */
	/omit-if-no-ref/
	reg_vlcd: vlcd_a {
		compatible = "regulator-fixed";
		regulator-name = "LCD0_VDD_EN";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_vlcd_a_on>;
		gpio = <&gpio4 20 GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		status = "disabled";
	};

	/* LCD1 power on voltage */
	/omit-if-no-ref/
	reg_vlcd_b: vlcd_b {
		compatible = "regulator-fixed";
		regulator-name = "LCD1_VDD_EN";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_vlcd_b_on>;
		gpio = <&gpio4 2 GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		status = "disabled";
	};

	/* SE050 power on voltage */
	reg_vref_se050: regulator_se050 {
		compatible = "regulator-fixed";
		regulator-name = "SE050_ENA";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_se050>;
		gpio = <&gpio1 0 GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		enable-active-high;
		status = "disabled";
	};

	/* CAM_PWR# power on voltage */
	reg_vref_cam0_pwr: regulator_cam0_pwr {
		compatible = "regulator-fixed";
		regulator-name = "CAM0_PWR";
		pinctrl-names = "default";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
		status = "disabled";
	};

	/* CAM_PWR# power on voltage */
	reg_vref_cam1_pwr: regulator_cam1_pwr {
		compatible = "regulator-fixed";
		regulator-name = "CAM1_PWR";
		pinctrl-names = "default";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
		status = "disabled";
	};

	reg_ldb_bl_a: ldb-bl-a {
		compatible = "regulator-fixed";
		regulator-name = "ldb-bl0";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ldb_bl_a>;
		gpio = <&gpio4 1 GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		status = "disabled";
	};

	reg_ldb_bl: ldb-bl-b {
		compatible = "regulator-fixed";
		regulator-name = "ldb-bl1";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ldb_bl_b>;
		gpio = <&gpio4 3 GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		status = "disabled";
	};

	usb_host_reset: gpio-reset {
		compatible = "gpio-reset";
		reset-gpios = <&pca6416 14 GPIO_ACTIVE_LOW>;
		reset-delay-us = <10>;
		#reset-cells = <0>;
		status = "disabled";
	};

	reg_wlan_pdn: regulator-usdhc3-wlan {
		compatible = "regulator-fixed";
		regulator-name = "WLAN_RESET";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_wlan_pdn>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio4 18 GPIO_ACTIVE_HIGH>;
		off-on-delay-us = <1000>;
		enable-active-low;
		status = "disabled";
	};

	sound-hdmi {
		compatible = "fsl,imx-audio-hdmi";
		model = "audio-hdmi";
		audio-cpu = <&aud2htx>;
		hdmi-out;
		constraint-rate = <44100>, <88200>, <176400>,
				  <32000>, <48000>,
				  <96000>, <192000>;
		status = "disabled";
	};
};

&aud2htx {
	status = "disabled";
};

&clk {
	assigned-clocks = <&clk IMX8MP_CLK_A53_SRC>,
			  <&clk IMX8MP_CLK_A53_CORE>,
			  <&clk IMX8MP_CLK_NOC>,
			  <&clk IMX8MP_CLK_NOC_IO>,
			  <&clk IMX8MP_CLK_GIC>,
			  <&clk IMX8MP_CLK_AUDIO_AHB>,
			  <&clk IMX8MP_CLK_AUDIO_AXI_SRC>,
			  <&clk IMX8MP_AUDIO_PLL1>,
			  <&clk IMX8MP_AUDIO_PLL2>,
			  <&clk IMX8MP_VIDEO_PLL1>,
			  <&clk IMX8MP_CLK_CLKOUT1>;
	assigned-clock-rates = <0>, <0>,
			       <1000000000>,
			       <800000000>,
			       <500000000>,
			       <400000000>,
			       <800000000>,
			       <393216000>,
			       <361267200>,
			       <1039500000>,
			       <24576000>;

	init-on-array = <IMX8MP_CLK_HSIO_ROOT>, <IMX8MP_CLK_CLKOUT1>;
};

&A53_0 {
	cpu-supply = <&buck2>;
};

&A53_1 {
	cpu-supply = <&buck2>;
};

&A53_2 {
	cpu-supply = <&buck2>;
};

&A53_3 {
	cpu-supply = <&buck2>;
};

&sm_gbe0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_gbe0>;
	phy-mode = "rgmii-id";
	phy-handle = <&ethphy0>;
	snps,force_thresh_dma_mode;
	snps,mtl-tx-config = <&mtl_tx_setup>;
	snps,mtl-rx-config = <&mtl_rx_setup>;
	status = "disabled";

	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy0: ethernet-phy@4 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <4>;
			rtl821x,clkout-disable;
			rtl821x,aldps-enable;
			rtl821x,ssc-rxc-enable;
			rtl821x,ssc-sysclk-enable;
			rtl821x,ssc-clkout-enable;
			rtl821x,led-link = <2>; // LED2 for link indication
			rtl821x,led-act = <0>; // LED0 for activity
			reset-gpios = <&pca6416 11 GPIO_ACTIVE_LOW>;
			reset-assert-us = <10000>;
			reset-deassert-us = <100000>;
			interrupt-parent = <&gpio1>;
			interrupts = <6 IRQ_TYPE_LEVEL_LOW>;
			eee-broken-1000t;
		};
	};

	mtl_tx_setup: tx-queues-config {
		snps,tx-queues-to-use = <5>;
		snps,tx-sched-sp;

		queue0 {
			snps,dcb-algorithm;
			snps,priority = <0x1>;
		};

		queue1 {
			snps,dcb-algorithm;
			snps,priority = <0x2>;
		};

		queue2 {
			snps,dcb-algorithm;
			snps,priority = <0x4>;
		};

		queue3 {
			snps,dcb-algorithm;
			snps,priority = <0x8>;
		};

		queue4 {
			snps,dcb-algorithm;
			snps,priority = <0xf0>;
		};
	};

	mtl_rx_setup: rx-queues-config {
		snps,rx-queues-to-use = <5>;
		snps,rx-sched-sp;

		queue0 {
			snps,dcb-algorithm;
			snps,priority = <0x1>;
			snps,map-to-dma-channel = <0>;
		};

		queue1 {
			snps,dcb-algorithm;
			snps,priority = <0x2>;
			snps,map-to-dma-channel = <1>;
		};

		queue2 {
			snps,dcb-algorithm;
			snps,priority = <0x4>;
			snps,map-to-dma-channel = <2>;
		};

		queue3 {
			snps,dcb-algorithm;
			snps,priority = <0x8>;
			snps,map-to-dma-channel = <3>;
		};

		queue4 {
			snps,dcb-algorithm;
			snps,priority = <0xf0>;
			snps,map-to-dma-channel = <4>;
		};
	};
};

&sm_gbe1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_gbe1>;
	phy-mode = "rgmii-id";
	phy-handle = <&ethphy1>;
	fsl,magic-packet;
	status = "disabled";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy1: ethernet-phy@5 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <5>;
			rtl821x,clkout-disable;
			rtl821x,aldps-enable;
			rtl821x,ssc-rxc-enable;
			rtl821x,ssc-sysclk-enable;
			rtl821x,ssc-clkout-enable;
			rtl821x,led-link = <2>; // LED2 for link indication
			rtl821x,led-act = <0>; // LED0 for activity
			reset-gpios = <&pca6416 12 GPIO_ACTIVE_LOW>;
			reset-assert-us = <10000>;
			reset-deassert-us = <100000>;
			interrupt-parent = <&gpio5>;
			interrupts = <1 IRQ_TYPE_LEVEL_LOW>;
			eee-broken-1000t;
		};
	};
};

#ifdef CONFIG_FSSMMX8MP_PWM_OUT
&sm_pwm_out {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_pwm_out>;
	status = "disabled";
};
#endif /* CONFIG_FSSMMX8MP_PWM_OUT */

#ifdef CONFIG_FSSMMX8MP_LCD0_BKLT
&sm_lcd0_bklt_pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_lcd0_bklt_pwm>;
	#pwm-cells = <3>;
	keep-power;
	status = "disabled";
};
#endif /* CONFIG_FSSMMX8MP_LCD0_BKLT */

#ifdef CONFIG_FSSMMX8MP_LCD1_BKLT
&sm_lcd1_bklt_pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_lcd1_bklt_pwm>;
	#pwm-cells = <3>;
	keep-power;
	status = "disabled";
};
#endif /* CONFIG_FSSMMX8MP_LCD1_BKLT */

&snvs_pwrkey {
	status = "disabled";
};

/* Disable CPU RTC - external available */
&snvs_rtc {
	status = "disabled";
};

&sm_i2c_cam0 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_i2c_cam0>;
	status = "disabled";
};

&sm_i2c_cam1 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_i2c_cam1>;
	status = "disabled";
};

&sm_i2c_gp {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_i2c_gp>;
	status = "disabled";

	/* EEPROM */
	eeprom: eeprom@50 {
		compatible = "atmel,24c64";
		reg = <0x50>;
		pagesize = <8>;
		vcc-supply = <&reg_vref_1v8>;
		status = "disabled";
	};
};

&sm_i2c_pm {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_i2c_pm>;
	status = "disabled";
};

&sm_i2c_lcd {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_i2c_lcd>;
	status = "disabled";
};

/* I2C_INT */
&i2c_int {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c_int>;
	status = "disabled";

	pmic: pca9450@25 {
		reg = <0x25>;
		compatible = "nxp,pca9450c";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_pmic>;
		interrupt-parent = <&gpio4>;
		interrupts = <19 IRQ_TYPE_LEVEL_LOW>;

		regulators {
			buck1: BUCK1 {
				regulator-name = "BUCK1";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <2187500>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <3125>;
			};

			buck2: BUCK2 {
				regulator-name = "BUCK2";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <2187500>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <3125>;
				nxp,dvs-run-voltage = <950000>;
				nxp,dvs-standby-voltage = <850000>;
			};

			buck4: BUCK4 {
				regulator-name = "BUCK4";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck5: BUCK5 {
				regulator-name = "BUCK5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck6: BUCK6 {
				regulator-name = "BUCK6";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3400000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo1: LDO1 {
				regulator-name = "LDO1";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo2: LDO2 {
				regulator-name = "LDO";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1150000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo3: LDO3 {
				regulator-name = "LDO3";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo4: LDO4 {
				regulator-name = "LDO4";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo5: LDO5 {
				regulator-name = "LDO5";
				regulator-compatible = "ldo5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};

	rtc85263: rtc85263@51 {
		compatible = "nxp,pcf85263";
		reg = <0x51>;
		clock-out = <PCF85263_CLK_OUT_32p768kHz>;

		quartz-load-capacitance = <PCF85263_QUARTZCAP_12p5pF>;
		quartz-drive-strength = <PCF85263_QUARTZDRIVE_LOW>;
		status = "disabled";
	};

	/* GPIO expander */
	pca6416: gpio@20 {
		compatible = "nxp,pcal6416";
		reg = <0x20>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_pca6416>;
		vcc-supply = <&reg_vref_1v8>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-parent = <&gpio4>;
		interrupts = <21 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpio4 22 GPIO_ACTIVE_LOW>;
		/* Enable Open-Drain for Port 0 and 1 */
		pcal6416,open-drain;
	};

	/* Temperature sensor 1 at PMIC */
	temp_pmic: temp_pmic@49 {
		compatible = "nxp,pct2075";
		reg = <0x49>;
		vs-supply = <&reg_vref_3v3>;
		#thermal-sensor-cells = <1>;
	};

	/* Temperature sensor 2 at DRAM */
	temp_dram: temp_dram@2c {
		compatible = "nxp,pct2075";
		reg = <0x2c>;
		vs-supply = <&reg_vref_3v3>;
		#thermal-sensor-cells = <1>;
	};
};

&sm_spi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_spi0>;
	status = "disabled";
};

&sm_spi1 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_spi1>;
	status = "disabled";
};

&sm_can0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_can0>;
	status = "disabled";
};

&sm_can1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_can1>;
	status = "disabled";
};

&sm_i2s0 {
	#sound-dai-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_i2s0>;
	assigned-clocks = <&clk IMX8MP_CLK_SAI2>;
	assigned-clock-parents = <&clk IMX8MP_AUDIO_PLL1_OUT>;
	assigned-clock-rates = <24576000>;
	clocks = <&audio_blk_ctrl IMX8MP_CLK_AUDIOMIX_SAI2_IPG>, <&clk IMX8MP_CLK_DUMMY>,
		 <&clk IMX8MP_CLK_CLKOUT1>, <&clk IMX8MP_CLK_DUMMY>,
		 <&clk IMX8MP_CLK_DUMMY>;
	clock-names = "bus", "mclk0", "mclk1", "mclk2", "mclk3";
	fsl,sai-mclk-direction-output;
	/* sai to clock and frame tx/rx master */
	fsl,txmasterflag = <1>; // SND_SOC_DAIFMT_CBM_CFM
	fsl,rxmasterflag = <1>; // SND_SOC_DAIFMT_CBM_CFM
	status = "disabled";
};

&sm_i2s2 {
	#sound-dai-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_i2s2>;
	assigned-clocks = <&clk IMX8MP_CLK_SAI3>;
	assigned-clock-parents = <&clk IMX8MP_AUDIO_PLL1_OUT>;
	assigned-clock-rates = <24576000>;
	clocks = <&audio_blk_ctrl IMX8MP_CLK_AUDIOMIX_SAI3_IPG>, <&clk IMX8MP_CLK_DUMMY>,
		 <&clk IMX8MP_CLK_CLKOUT1>, <&clk IMX8MP_CLK_DUMMY>,
		 <&clk IMX8MP_CLK_DUMMY>;
	clock-names = "bus", "mclk0", "mclk1", "mclk2", "mclk3";
	fsl,sai-mclk-direction-output;
	/* sai to clock and frame tx/rx master */
	fsl,txmasterflag = <1>; // SND_SOC_DAIFMT_CBM_CFM
	fsl,rxmasterflag = <1>; // SND_SOC_DAIFMT_CBM_CFM
	status = "disabled";
};

&sdma2 {
	status = "disabled";
};

&sm_ser1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_ser1>;
	assigned-clocks = <&clk IMX8MP_CLK_UART1>;
	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_80M>;
	status = "disabled";
};

&sm_ser0 {
	/* console */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_ser0>;
	status = "disabled";
};

&sm_ser3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_ser3>;
	assigned-clocks = <&clk IMX8MP_CLK_UART3>;
	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_80M>;
	status = "disabled";
};

&sm_ser2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_ser2>;
	assigned-clocks = <&clk IMX8MP_CLK_UART4>;
	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_80M>;
	status = "disabled";
};

&pcie {
	clkreq-gpio = <&pca6416 15 GPIO_ACTIVE_LOW>;
	reset-gpio = <&pca6416 13 GPIO_ACTIVE_LOW>;
	vpcie-supply = <&reg_vref_3v3>;
	status = "disabled";
};

&pcie_phy {
	fsl,refclk-pad-mode = <IMX8_PCIE_REFCLK_PAD_OUTPUT>;
	clocks = <&hsio_blk_ctrl>;
	clock-names = "ref";
	status = "disabled";
};

/* USB_A */
&usb3_phy0 {
	fsl,phy-tx-preemp-amp-tune = <3>;
	fsl,phy-tx-vref-tune = <0xb>;
	status = "disabled";
};

&usb3_0 {
	status = "disabled";

	connector {
		compatible = "gpio-usb-b-connector", "usb-b-connector";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_sm_usb0_id>;
		id-gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;

		port {
			connector_dr_sw: endpoint {
				remote-endpoint = <&usb3_drd_sw>;
			};
		};
	};
};

&sm_usb0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_usb0_pwr>;
	dr_mode = "otg";
	hnp-disable;
	srp-disable;
	adp-disable;
	usb-role-switch;
	role-switch-default-mode = "none";
	status = "disabled";

	port {
		usb3_drd_sw: endpoint {
			remote-endpoint = <&connector_dr_sw>;
		};
	};
};

/* USB_B */
&usb3_phy1 {
	/* vbus-power-supply = <&ptn5110>; */
	fsl,phy-tx-vref-tune = <0xe>;
	fsl,phy-tx-preemp-amp-tune = <3>;
	fsl,phy-tx-vboost-level = <5>;
	fsl,phy-comp-dis-tune = <7>;
	fsl,pcs-tx-deemph-3p5db = <0x21>;
	fsl,phy-pcs-tx-swing-full = <0x7f>;
	status = "disabled";
};

&usb3_1 {
	status = "disabled";
};

&sm_usb1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sm_usb1_pwr>;
	resets = <&usb_host_reset>;
	dr_mode = "host";
	status = "disabled";
};

/* SD_C - internal eMCC boot device */
&emmc {
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_emmc>;
	pinctrl-1 = <&pinctrl_emmc_100mhz>;
	pinctrl-2 = <&pinctrl_emmc_200mhz>;
	non-removable;
	bus-width = <8>;
	status = "disabled";
};

/* SD_A - internal Micro-SD */
&sm_sdio {
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_sm_sdio>;
	pinctrl-1 = <&pinctrl_sm_sdio_100mhz>;
	pinctrl-2 = <&pinctrl_sm_sdio_200mhz>;
	bus-width = <4>;
	status = "disabled";
};

/* SD_WLAN */
&sd_wlan {
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_sd_wlan>;
	pinctrl-1 = <&pinctrl_sd_wlan_100mhz>;
	pinctrl-2 = <&pinctrl_sd_wlan_200mhz>;
	vmmc-supply = <&reg_wlan_pdn>;
	vqmmc-supply = <&reg_vref_1v8>;
	fsl,sdio-async-interrupt-enabled;
	pm-ignore-notify;
	keep-power-in-suspend;
	non-removable;
	cap-power-off-card;
	bus-width = <4>;
	status = "disabled";
	#address-cells = <1>;
	#size-cells = <0>;

	mwifiex: wifi@1 {
		compatible = "marvell,sd8997";
		reg = <1>;
		status = "disabled";
	};
};

&sm_csi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "disabled";
};

&sm_csi1 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "disabled";
};

&wdog1 {
	pinctrl-names = "default";
