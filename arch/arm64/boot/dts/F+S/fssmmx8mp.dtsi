&vpu_g2 {
	status = "disabled";
};

&vpu_vc8000e {
	status = "disabled";
};

&vpu_v4l2 {
	status = "disabled";
};

&gpu_3d {
	status = "disabled";
};

&gpu_2d {
	status = "disabled";
};

&ml_vipsi {
	status = "disabled";
};

&mix_gpu_ml {
	status = "disabled";
};

&cameradev {
	status = "disabled";
};

&isi_0 {
	status = "disabled";
	dma-coherent;
	bsl,dma-invalidate;
	fsl,chain_buf;
};

&isi_1 {
	status = "disabled";
	dma-coherent;
	bsl,dma-invalidate;
	fsl,chain_buf;
};

&isp_0 {
	/* remove this property because this region used
	 * only by tuning tool
	 */
	/delete-property/ memory-region;
	status = "disabled";
