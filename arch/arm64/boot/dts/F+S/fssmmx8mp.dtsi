	/* 4 */  "SD_VSEL", "GPIO2", "ETH_A_PHY_IRQ", "GPIO1",
	/* 8 */  "GPIO3", "GPIO0", "USB_A_ID", "GPIO7",
	/* 12 */ "USB_A_PWREN_1V8", "USB_A_OC#_1V8", "USB_B_PWREN_1V8", "USB_B_OC#_1V8",
	/* 16 */ "ETH_A_RGMII_MDC", "ETH_A_RGMII_MDIO", "ETH_A_RGMII_TXD3", "ETH_A_RGMII_TXD2",
	/* 20 */ "ETH_A_RGMII_TXD1", "ETH_A_RGMII_TXD0", "ETH_A_RGMII_TXCTL", "ETH_A_RGMII_TXC",
