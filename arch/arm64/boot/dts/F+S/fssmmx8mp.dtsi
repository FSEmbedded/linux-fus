	/* 8 */  "ETH_B_RGMII_RXD2", "ETH_B_RGMII_RXD3", "ETH_B_RGMII_RXCTL", "ETH_B_RGMII_RXC",
	/* 12 */ "ETH_B_RGMII_TXD0", "ETH_B_RGMII_TXD1", "ETH_B_RGMII_TXD2", "ETH_B_RGMII_TXD3",
	/* 16 */ "ETH_B_RGMII_TXCTL", "ETH_B_RGMII_TXC", "WLAN_RST", "PMIC_IRQ",
